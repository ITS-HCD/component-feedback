{
  "name": "component-nys-feedback",
  "version": "0.1.0",
  "description": "nys-feedback, a sample NYSDS web component built with Lit, demonstrated in the NYSDS Playground.",
  "scripts": {
    "start": "node bin/cli.mjs",
    "present": "node bin/cli.mjs --present",
    "predev": "npm run deck",
    "dev": "vite",
    "prebuild": "npm run deck",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts bin/*.test.mjs",
    "deck": "node scripts/build-deck.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITS-HCD/component-feedback.git"
  },
  "homepage": "https://its-hcd.github.io/component-feedback/",
  "bugs": {
    "url": "https://github.com/ITS-HCD/component-feedback/issues"
  },
  "type": "module",
  "dependencies": {
    "@nysds/components": "1.21.0",
    "@nysds/styles": "1.21.0",
    "idb-keyval": "6.2.2",
    "lz-string": "1.5.0",
    "playground-elements": "0.21.2",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
